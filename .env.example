# ---------- frontend (apps/web/.env) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE=http://localhost:8787
VITE_RAZORPAY_KEY_ID=

# ---------- worker (apps/worker/.env) ----------
PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SARVAM_API_KEY=
REDIS_URL=redis://localhost:6379
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CAPTION_RETENTION_DAYS=7

# ffmpeg binaries — leave blank to use PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Sarvam plan rate limit (req/min): starter 60, pro 200, business 1000
SARVAM_RATE_LIMIT_RPM=60
